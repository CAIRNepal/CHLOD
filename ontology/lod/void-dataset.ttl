@prefix void: <http://rdfs.org/ns/void#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hg: <https://cair-nepal.org/heritagegraph/> .

hg:dataset/public
  a void:Dataset, dcat:Dataset ;
  dcterms:title "HeritageGraph public knowledge graph"@en ;
  dcterms:creator <https://cairnepal.org/> ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  void:uriSpace <https://cair-nepal.org/heritagegraph/resource/> ;
  void:sparqlEndpoint <https://cair-nepal.org/heritagegraph/sparql> ;
  void:subset <https://cair-nepal.org/heritagegraph/graph/public> ;
  dcat:distribution [
    a dcat:Distribution ;
    dcterms:format "application/n-quads" ;
    dcat:accessURL <https://cair-nepal.org/heritagegraph/dataset/public/dump.nt> ;
  ] .
